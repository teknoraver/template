#!/bin/sh

# SPDX-License-Identifier: GPL-3.0-or-later

[ $# -ne 1 ] && exec echo "$0 AppName"

AppName=$1
APPNAME=$(echo "$1" | tr '[:lower:]' '[:upper:]')
appname=$(echo "$1" | tr '[:upper:]' '[:lower:]')

sed -i \
	-e "s/Template/$AppName/g" \
	-e "s/TEMPLATE/$APPNAME/g" \
	-e "s/template/$appname/g" \
	main.cpp template.cpp template.h CMakeLists.txt template.qrc template.rc templatewidget.ui
for f in template* imgs/template*; do
	mv "$f" "$(dirname "$f")/$(basename "$f" | sed "s/template/$appname/")"
done
